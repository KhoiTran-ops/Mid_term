# Authenticated DNSE price/history access. Keep real values only in .env.
DNSE_API_KEY=
DNSE_API_SECRET=

# Local storage paths (relative to the project root).
DATABASE_PATH=var/market_data.db
REPORTS_DATABASE_PATH=var/reports.db
REPORTS_DIRECTORY=outputs/reports
NEWS_DATABASE_PATH=var/news.db
INDUSTRIES_DATABASE_PATH=var/industries.db

# News scheduling.
NEWS_AUTO_UPDATE=true
