{
  "version": "stocklens-strategy-1.0",
  "weights": {"fa": 0.2, "ta": 0.8},
  "entry": 60, "exit": 35,
  "min_liquidity_bn_vnd": 2,
  "market_regime": {"index_ma_window": 200},
  "ta": {
    "momentum": {"points": 30, "months": [3, 6, 12]},
    "relative_strength": {"points": 25, "months": 6},
    "trend": {"points": 25},
    "breakout": {"points": 15, "lookback": 20},
    "volume": {"points": 5, "lookback": 20, "min_ratio": 0.8}
  },
  "fa": {
    "pillars": {
      "quality": {"weight": 0.40, "enabled": true, "metrics": [
        {"key": "roe", "lo": 0, "hi": 30, "w": 0.40},
        {"key": "roa", "lo": 0, "hi": 15, "w": 0.25},
        {"key": "net_margin", "lo": 0, "hi": 20, "w": 0.15},
        {"key": "ocf_to_ni", "lo": 0, "hi": 1.2, "w": 0.20}]},
      "growth": {"weight": 0.25, "enabled": true, "metrics": [
        {"key": "ni_yoy", "lo": 0, "hi": 40, "w": 0.5},
        {"key": "rev_cagr_3y", "lo": 0, "hi": 35, "w": 0.5}]},
      "value": {"weight": 0.20, "enabled": false, "metrics": []},
      "safety": {"weight": 0.15, "enabled": true, "metrics": [
        {"key": "debt_to_equity", "lo": 2.0, "hi": 0.5, "w": 0.5},
        {"key": "current_ratio", "lo": 1.0, "hi": 1.5, "w": 0.5}]}
    },
    "exclude_if": {"net_income_le": 0, "equity_le": 0}
  }
}
